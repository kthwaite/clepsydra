{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": ["ES2022", "DOM"],
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"#/*": ["./src/*"],
			"@mixmark-io/domino": ["./src/types/domino.d.ts"]
		},
		"types": ["chrome-types"]
	},
	"include": ["src"]
}
