{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "./src/**/*.{js,ts,jsx,tsx}",
      "./*.{json,js,ts}",
      "!src/routeTree.gen.ts"
    ]
  },
  "linter": {
    "enabled": true
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
